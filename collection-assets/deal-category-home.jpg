n tiiltä."}]},"heating":{"systemCodes":["GEOTHERMAL_HEATING"],"distributionSystemCodes":["WATER_UNDERFLOOR_HEATING"],"description":[{"languageCode":"fi","text":"Maalämpö, asunnoissa vesikiertoinen lattialämmitys, LTO, A-energialuokka. "}]},"ventilation":{"systemCodes":[],"systemsDescription":[{"languageCode":"fi","text":"Koneellinen, LTO (asuntokohtainen)"}]},"outerRoof":{"typeCode":"GABLED","materialCode":"OTHER","otherMaterialDescription":[{"languageCode":"fi","text":"Peltikate (sileä)"}]},"hasElevator":"YES","hasSauna":"NO","premises":{"typeCodes":[],"description":[{"languageCode":"fi","text":"Ulkoiluvälinevarasto (kylmä ja lämmin), talovarasto, irtaimistovarastot, jätehuone, talopesula, ulkokuntoilupaikka pihalla, lasten leikkipaikka (kts asemapiirustus), hissi. Pihapaikkojen hv 32€/kk. Kylmä at 2 €/m2, puolilämmin at 50,4-56 €/kk, kts yhtiöjärjestyskestä maksuperusteet. Irtaimistovarastojen numerointi päivitetty 3/2026 (kts piirustus)"}]}},"plot":{"holdingTypeCode":"LEASEHOLD","landlord":"DEAS-tonttirahasto Ky","optionalRentalPlot":"YES","optionalRentalPlotDescription":[{"languageCode":"fi","text":"DEAS-tonttirahasto ky. Kts liitteenä maanvuokrasopimus. Lunastus kaupanteon jälkeen tai vuosittain (kts ehdot tarkemmin määräosien lunastussopimuksesta ja maanvuokrasopimuksesta, tontin lunastus 3% vs-vero). "}],"leaseAgreementDescription":[{"languageCode":"fi","text":"Kts maanvuokrasopimus ja sopimus määräosien lunastuksesta. "}],"area":{"value":1481,"areaUnitCode":"M2"},"zoning":{"typeCodes":["CITY_PLAN"],"description":[{"languageCode":"fi","text":"Asemakaava, tied. Hgin kaupunki p. 09 310 1691, www.hel.fi / www.kartta.hel.fi / www.kartta.hel.fi/suunnitelmat  tai Ann-Charlotte Roberts tai Stella Vahteristo 040 6234 204 / 09-310 370 33 / 09 310 56 003, tai kysy välittäjältä. "}]},"beach":[],"constructionRight":[],"unbuiltPlot":false},"internetConnections":{"broadbandAvailable":"YES","fiberOpticInternet":"YES"},"television":{"typeCodes":[]},"energyCertificate":"A2018","asbestosMapping":{"isAsbestosMappingDone":"NO"},"parkingSpaces":[{"parkingSpaceTypeCode":"GARAGE","count":5},{"parkingSpaceTypeCode":"OUTDOOR_PARKING_SPACE_WITH_ELECTRICAL_PLUG","count":11}],"parkingSpaceDescription":[{"languageCode":"fi","text":"Autotallit  ja autopaikat myydään erikseen osakkeina. AT 2-5 lämpimiä, AT1 kylmä. Hinnat 30-35teur. Talleissa/ autopaikoissa sähköautonlatausvalmius. "}],"housingCompanyPremiseStatistics":[{"premiseTypeCode":"APARTMENT","count":18,"area":{"value":1232,"areaUnitCode":"M2"},"managedByHousingCompanyCount":0,"areaManagedByHousingCompany":{"value":0,"areaUnitCode":"M2"}},{"premiseTypeCode":"BUSINESS_PREMISE","count":2,"area":{"value":125,"areaUnitCode":"M2"},"managedByHousingCompanyCount":0,"areaManagedByHousingCompany":{"value":0,"areaUnitCode":"M2"}}],"renovations":[],"renovationsDescription":[{"languageCode":"fi","text":"Uudiskohde, arvioitu valmistuminen 3012/2026"}],"renovationsPlannedDescription":[{"languageCode":"fi","text":"Sisäänmuuttotarkastus ja 1-vuotistarkastus asuntokauppalain mukaan. "}],"additionalDescription":[{"languageCode":"fi","text":"Taloyhtiön väylät/parkki-alue pääosin asfaltoitu, osin nurmikivetty. Autotalleissa nro 2-5 patterilämmitys (vesikiertoiset patterit), \nAt1 kylmä talli. Yleinen piha-alue asemapiirroksen yms suunnitelmien mukaisesti (ulkokuntoilupaikka, lasten leikkipaikka yms). www.pakilanpromenadi.fi "}],"area":1481,"ownership":"RENTED","yearBuilt":2026,"yearStartOfUse":2027,"elevator":true,"buildingMaterial":"Tiili.<br /><br />Tiili, betoni, julkisivu pääosin tiiltä.","heating":"Maalämpö<br /><br />Lämmönjakotapa: Vesikiertoinen lattialämmitys<br /><br />Maalämpö, asunnoissa vesikiertoinen lattialämmitys, LTO, A-energialuokka. ","roofType":"Harjakatto","roofMaterial":"Peltikate (sileä)","responsibleForMaintenance":"Huoltoyhtiö","appliancesAndEquipment":"Ulkoiluvälinevarasto (kylmä ja lämmin), talovarasto, irtaimistovarastot, jätehuone, talopesula, ulkokuntoilupaikka pihalla, lasten leikkipaikka (kts asemapiirustus), hissi. Pihapaikkojen hv 32€/kk. Kylmä at 2 €/m2, puolilämmin at 50,4-56 €/kk, kts yhtiöjärjestyskestä maksuperusteet. Irtaimistovarastojen numerointi päivitetty 3/2026 (kts piirustus)","renovationsDone":"","renovationsKnownInFuture":"","buyerCosts":null,"additionalInfo":"Taloyhtiön väylät/parkki-alue pääosin asfaltoitu, osin nurmikivetty. Autotalleissa nro 2-5 patterilämmitys (vesikiertoiset patterit), \nAt1 kylmä talli. Yleinen piha-alue asemapiirroksen yms suunnitelmien mukaisesti (ulkokuntoilupaikka, lasten leikkipaikka yms). www.pakilanpromenadi.fi ","housingRegistryShareholdersIndex":null,"numberOfApartments":18,"numberOfOffices":2,"overallApartmentArea":1232,"overallOfficeArea":125,"redemption":null},"description":"Uudiskohde Länsi-Pakilasta - RS-kohde maalämmöllä ja upeilla sisäänvedetyillä lasiparvekkeilla! Autotallimahdollisuus (32teur) - edulliset asumiskulut!\n\nAs Oy Helsingin Pakilan Promenadi on ainutlaatuinen yhdistelmä tyylikkyyttä, helppoa asumista ja luonnonläheisyyttä – täydellinen valinta jokaiselle arvokkuudesta, näyttävästä ja modernista asumisesta sekä vaivattomasta arjesta haaveilevalle. Tämä nelikerroksinen, vain 18 asunnon arvokiinteistö on suunniteltu asukkaille, jotka arvostavat avaruutta, valoa ja viimeisteltyjä yksityiskohtia. Vuodenvaihteessa 2026-27 valmistuva Pakilan Promenadi on suunniteltu asukkaille, jotka haluavat jättää hyvästit pihanhoidolle, remontoinnille ja kodin ylläpitohuolille, mutta eivät korkeatasoiselle asumiselle. \nPakilan Promenadissa voit nauttia modernin arvokodin näyttävyydestä, rauhasta ja modernista mukavuudesta sekä Pakilan ainutlaatuisesta, luontoa ja kaupunkielämää yhdistävästä tunnelmasta. Laadukkaat pintamateriaalit, viimeistellyt yksityiskohdat ja energiatehokas maalämpö A-energialuokalla tuovat asumiseen huolettomuutta jopa vuosikymmeniksi eteenpäin. Asunnoissa on nykyaikainen lattialämmitys, hyvin varustellut keittiöt integroiduilla kodinkoneilla, saunat, lasitetut parvekkeet sekä kylpyhuoneet, joiden tyylikkyys ja toimivuus ilahduttavat arjen keskellä.\nKodit on rakennettu kestämään aikaa sekä esteettisesti että teknisesti. Ajaton arkkitehtuuri, puuverhoilulla viimeistellyt yksityiskohdat ja laadukkaat pintamateriaalit antavat kodillesi arvoisensa puitteet tänään ja tulevaisuudessa.\nhttps://pakilanpromenadi.fi/\nESITTELYT TONTILLA JA RAKENNUKSELLA. \n\n","latitude":60.2443561,"longitude":24.9255947,"openHouses":[],"seaOrLakeView":false,"privateShore":false,"realtyZoning":[],"realtyBuilding":{"livingAreaVerified":false},"realtyInfo":null,"landOwnership":{"type":"LEASEHOLD","lotRedemptionPrice":null,"flexibleRentedOwnershipInformation":"DEAS-tonttirahasto ky. Kts liitteenä maanvuokrasopimus. Lunastus kaupanteon jälkeen tai vuosittain (kts ehdot tarkemmin määräosien lunastussopimuksesta ja maanvuokrasopimuksesta, tontin lunastus 3% vs-vero). "},"agent":{"key":"fb42f2c4-913b-484e-821f-8ec0fc083180","name":"Nico Autero","email":"nico.autero@kiinteistomaailma.fi","phone":"+358505214810","agency":" Helsinki Pakila-Paloheinä","degrees":"Julkinen kaupanvahvistaja, KTM, LKV","title":"KTM, LKV"},"newConstructionInfo":{"estimatedTimeOfCompletion":"30.12.2026"},"commentsFromSeller":"","excludeGoogleStreetView":false,"pros":[],"links":[],"valueListing":false,"initialPublishTimestamp":{"sec":1761909331,"usec":0},"latestPublishTimestamp":{"sec":1791111173,"usec":0},"providerAgentKeys":["690nau"],"managerAgentKeys":["690nau"],"location":{"type":"Point","coordinates":[24.9255947,60.2443561]},"digipaper":true,"digipaperArea":["helsinki-pohjoinen","pääkaupunkiseutu"],"sortArea":66.5,"sortYearBuilt":2026,"groupType":["kerrostaloasunnot","asunnot","uudiskohteet"],"video":false,"hasParkingSpace":true,"geothermalHeating":true,"seniorHousing":false,"dbHousingCompany":false,"agentKey":"fb42f2c4-913b-484e-821f-8ec0fc083180","allAgentKeys":["690nau"],"urlPart":"1404784","urlParts":["helsinki_myytavat_kerrostaloasunnot/1404784","1404784"],"urlCity":"helsinki","urlDistrict":"lansi-pakila","ord":1,"expire":0,"nameSort":"","modified":{"sec":1791111426,"usec":284000},"created":{"sec":1761909604,"usec":608000},"classType":"km-vilpas","counters":{"searchWatchers":2,"contactForms":1},"propertyTypeCode":"RESIDENTIAL","subcategoryCode":"SHARE","housingCompanyCharges":{"managementCharge":266,"financingCharge":{"amount":561.15},"plot":{"rentCharge":411.14},"maintenanceCharge":1238.29,"currencyCode":"EUR"},"contact":{"firstName":"Nico","lastName":"Autero","title":"KTM, LKV","phone":"+358505214810","email":"nico.autero@kiinteistomaailma.fi","profilePictureUrl":"https://d33xsej2pkrh3b.cloudfront.net/fit/oviproprodmedia/Production/business_user_profile/fb42f2c4-913b-484e-821f-8ec0fc083180/3a88dbd6-88b8-498f-9ff7-14739bba7cfb.png"},"realtyStatusCode":"FOR_SALE","agencyOfficeId":"5a9b9ef2-e232-45b7-9bba-7de893a9e242","realty":{"newBuilding":"YES","costs":[{"typeCode":"WATER","waterChargeTypeCode":"BY_USE"}],"costsDescription":[{"languageCode":"fi","text":"Sauna, pesula yms maksut päätetään myöhemmin. Rahoitusvastike ilmoitettu lyhennysvapaan aikana (lyhennysten alkaessa arvio 1402,45eur/kk). Tonttiosuuden voi lunastaa (vs-vero 3% tontin osalta). Vuokratontin lunastushinta arvioitu  82 227,36 euroa  (kts lisätiedot). "}],"auctionAllowed":false,"sellingPrice":154800,"currencyCode":"EUR","availability":{"code":"OTHER","description":[{"languageCode":"fi","text":"Kohteen valmistuttua 2026/2027 vuodenvaihteessa, arvioitu 31.12.2026. "}]},"isRented":"NO","address":{"streetAddress":"Elontie 71","stairwell":"A","apartmentNumber":"4","district":"Länsi-Pakila","districtCode":"FI_UUSIMAA_HELSINKI_PAKILA_LANSIPAKILA","region":"Uusimaa","regionCode":"FI_UUSIMAA","postcode":"00660","postalArea":"Helsinki","locality":"Helsinki","localityCode":"FI_UUSIMAA_HELSINKI","country":"Suomi","countryCode":"FI","location":{"latitude":60.2443561,"longitude":24.9255947,"coordinateAccuracy":"UNKNOWN"},"showMapOnAnnouncement":"YES"},"description":[{"languageCode":"fi","text":"Uudiskohde Länsi-Pakilasta - RS-kohde maalämmöllä ja upeilla sisäänvedetyillä lasiparvekkeilla! Autotallimahdollisuus (32teur) - edulliset asumiskulut!\n\nAs Oy Helsingin Pakilan Promenadi on ainutlaatuinen yhdistelmä tyylikkyyttä, helppoa asumista ja luonnonläheisyyttä – täydellinen valinta jokaiselle arvokkuudesta, näyttävästä ja modernista asumisesta sekä vaivattomasta arjesta haaveilevalle. Tämä nelikerroksinen, vain 18 asunnon arvokiinteistö on suunniteltu asukkaille, jotka arvostavat avaruutta, valoa ja viimeisteltyjä yksityiskohtia. Vuodenvaihteessa 2026-27 valmistuva Pakilan Promenadi on suunniteltu asukkaille, jotka haluavat jättää hyvästit pihanhoidolle, remontoinnille ja kodin ylläpitohuolille, mutta eivät korkeatasoiselle asumiselle. \nPakilan Promenadissa voit nauttia modernin arvokodin näyttävyydestä, rauhasta ja modernista mukavuudesta sekä Pakilan ainutlaatuisesta, luontoa ja kaupunkielämää yhdistävästä tunnelmasta. Laadukkaat pintamateriaalit, viimeistellyt yksityiskohdat ja energiatehokas maalämpö A-energialuokalla tuovat asumiseen huolettomuutta jopa vuosikymmeniksi eteenpäin. Asunnoissa on nykyaikainen lattialämmitys, hyvin varustellut keittiöt integroiduilla kodinkoneilla, saunat, lasitetut parvekkeet sekä kylpyhuoneet, joiden tyylikkyys ja toimivuus ilahduttavat arjen keskellä.\nKodit on rakennettu kestämään aikaa sekä esteettisesti että teknisesti. Ajaton arkkitehtuuri, puuverhoilulla viimeistellyt yksityiskohdat ja laadukkaat pintamateriaalit antavat kodillesi arvoisensa puitteet tänään ja tulevaisuudessa.\nhttps://pakilanpromenadi.fi/\nESITTELYT TONTILLA JA RAKENNUKSELLA. \n\n"}],"notifyIfPriceChanged":"YES","title":[{"languageCode":"fi","text":"3 h, k, kph/2wc/kh, sauna, las. parveke"}],"transactionIncludes":[{"languageCode":"fi","text":"Sälekaihtimet, vaatekaapistot, lasitettu parveke, valokuitu. . TV-antennit: Liitetty yhtiön kaapeli-tv liittymään. Tietoliikenneyhteydet: Valokuitu"}],"condition":{"code":"NEW"},"additionalAreaMeasurementInformation":[{"languageCode":"fi","text":"Sisäänvedetty kulmaparveke, kellarikomero"}],"additionalInformation":{"additionalDescription":[{"languageCode":"fi","text":"Rakennuttajana Pajala Etelä-Suomi Oy. Kts lisätietoja https://pakilanpromenadi.fi/ Jotkin ennakkomarkkinoinnissa annetut tiedot ovat saattaneet muuttua (kts asuntoesite ja muu materiaali 3-/2026).\n\nLisätietoa tontin lunastuksesta ja vuokravastikkeesta As Oy Helsingin Pakilan Promenadi: \nHinta-arvio tonttiosuuden lunastusosuudelle on laskettu 2025/11 mukaan. Lunastusosuuden (vuokratonttiosuus) hinta on sidottu elinkustannusindeksiin (kts sopimus/välittäjältä). Lunastusajankohta on rakennuksen valmistuessa ja siitä seuraavaksi 11/2027 jatkuen vuosittain aina marraskuussa. Hinta tarkistetaan lunastuksen yhteydessä. \nLunastukseen liittyvät muut kustannukset: Taloyhtiön veloittamat kustannukset (esim. kaupanvahvistusmaksu) ja yhtiön maksettavaksi tuleva varainsiirtovero 3% lisätään lunastushintaan. Tontin vuokravastikkeen maksaminen ei vähennä tontin osan lunastushintaa. Vuokravastiketta peritään, jos et lunasta asunto-osakkeisiin kohdistuvaa tontin osuutta taloyhtiölle. Vuokravastiketta tarkistetaan valmistumisen yhteydessä ja vuosittain. \nVuokranantaja on DEAA-tonttirahasto ky. Tonttiosuuden voi lunastaa kaupanteossa tai vuosittain marraskuussa. Maanvuokrasopimuksen saa nähtäville välittäjältä, samoin lunastusehdot ja -sopimuksen (jotka päivätty 14.12.2023). \n"}],"nearbyAmenitiesDescription":[{"languageCode":"fi","text":"Koulut: Pakilan ylä- ja ala-aste, Paloheinän ala-aste, Torpparinmäen peruskoulu (1-9lk), Maunulan koulut, Metsolan koulu (Itä-Pakila), suomalais-venäläinen koulu, Oulunkylän ja Käpylän lukio alk.  n. 0,5 km; Päiväkodit: Pk Eloisa (Havukka), Montessori, Pikku Marjatta ja Pakila (Länsi-Pakila), Pk Miilu, Kytöniitty, Valkea, Pikkusuo (Paloheinä), Pk Vallesmanni, Kotitorppa, Torpparintupa, Norlandia (Torpparinmäki), Pk Haltia, Tammi, Ankkalampi, Perhonen, Pakilan lastenpaikka (Itä-Pakila), Pk Korento, Maunula yms (Maunula) alk. n. 0,5 km; Ruokakaupat: S-market (Pakila, Maunula ja Torpparinmäki), K-supermarket (Torpparinmäki), Alepa (Paloheinä, Maunula ja Itä-Pakila), LIDL (Pakila), K-market Pikkusisko (Itä-Pakila), Teboil (Pakila), Kaari kauppakeskus ja Prisma, ABC-Tuomarinkylä, City-Market Tammisto alk. n. 0,6 km; Muut lähipalvelut: Paloheinän golf, jäähalli, pulkkamäki, kiipeilypuisto, frisbee-golf-rata, hiihtoladut, Haltialan ulkoilualueet, Keskuspuisto, Tuomarinkylän miljöö, Pakilan musiikkiopisto, Paloheinän musiikkikoulu ja kuvataidekoulu, HPS-arena, Namika-arena, Paloheinän ja Maunulan kirjasto ja terveyskeskus, apteekki, R-kioski, lähikahvilat ja Palomaja, Alko, Teboil-Pakila, Kukkatalo, Kauppakeskus Kaari, Oulunkylän ja Pirkkolan liikuntapuisto (mm. luistinrata, tenniskenttä, padel, uimahalli) alk. n. 0,6 km"}],"transportationServicesDescription":[{"languageCode":"fi","text":"Bussit esim. 66, 63, 67, 64, 23, 553, 560, Pikaratikka 15 (Oulunkylä-Maunula-Pirkkola), Tuusulanväylä ja Kehä I linjat ja vaihtopysäkit alk n. 0,1 km"}]},"tenantResponsibleFor":[],"realtyTags":[]},"categoryCode":"SALE","realtyId":"f02a1b2c-e4ad-4faf-a55b-a1f25dce0b64","realtyTypeCode":"RESIDENTIAL_SHARE","residentialShare":{"residentialTypeCode":"APARTMENT_HOUSE","ownershipTypeCode":"OWN","apartment":{"officialRoomStructure":"3 h, k, s","roomCountCode":"3H","area":{"areaBasisCodes":["ARTICLES_OF_ASSOCIATION"],"livingArea":{"value":66.5,"areaUnitCode":"M2"},"totalArea":{"value":66.5,"areaUnitCode":"M2"}},"floors":{"floorLevel":2,"livingFloorCount":1,"totalFloorCount":4},"asbestosMapping":{"isAsbestosMappingDone":"NO"},"hearth":{"typeCodes":[]},"hasBalcony":"YES","balcony":{"typeCodes":["RETRACTED","GLAZED","OTHER"],"typeOtherDescription":[{"languageCode":"fi","text":"kulmaparveke lasikaiteella"}],"compassPoints":["NORTH","EAST"]},"terrace":[],"yard":[],"rooms":[{"typeCode":"KITCHEN","description":[{"languageCode":"fi","text":"Puustelli-keittiö, jääkaappi/pakastin