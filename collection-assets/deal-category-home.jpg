m"><div class="sc-bNQFlB gHDLQF"><h3 class="sc-dRCTWM ijsISk">Myymälä</h3><div class="sc-cgHJcJ dcVlcI"><span class="sc-hizQCF dGIOCb"><span>Kiinteistömaailma <!-- -->Helsinki Pakila-Paloheinä</span><span>(<!-- -->LKV Autero Oy <!-- -->)</span><span class="light">Pakilantie 85 (Lh 13)<!-- -->, <!-- -->00660<!-- --> <!-- -->Helsinki</span></span><span class="sc-hizQCF dGIOCb"><span class="phone"><i><svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="phone" class="svg-inline--fa fa-phone fa-w-16 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"></path></svg></i><a href="tel:0503386438" itemProp="telephone"><span>0503386438</span></a></span></span></div></div><a class="sc-hARARD glJTka" href="/helsinki-pakila-paloheina">Lue lisää</a></div><div class="sc-dBaXSw gSSRTm"><div class="sc-bNQFlB gHDLQF"><h3 class="sc-dRCTWM ijsISk">Rakennuttaja</h3><div class="builder"><div><a href="/helsingin-pakilan-promenadi">Katso rakennuttajan sivu</a></div><div class="sc-cgHJcJ dcVlcI">Asunto Oy Helsingin Pakilan Promenadi</div></div></div><a href="/helsingin-pakilan-promenadi" class="sc-hARARD glJTka">Lue lisää</a></div></div><div id="apartment-specs" class="sc-koErNt gMqpen"><div class="sc-gGCbJM jkhudZ"><div class="sc-lcpuFF gBszgu"><h3>Asunnon tiedot</h3><span class="sc-bqjOQT bzuiHt"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl brwBVU"><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kohdenumero</span><span class="sc-nrwXf cJAasx">1404784</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Talotyyppi</span><span class="sc-nrwXf cJAasx">Kerrostalo</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Sijainti</span><span class="sc-nrwXf cJAasx">Elontie 71 A 4, 00660 Helsinki</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kaupunginosa</span><span class="sc-nrwXf cJAasx">Länsi-Pakila</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Huoneluku</span><span class="sc-nrwXf cJAasx">3 h, k, kph/2wc/kh, sauna, las. parveke</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Asuinpinta-ala</span><span class="sc-nrwXf cJAasx">66.5 m&sup2;, yhtiöjärjestyksen mukaan</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Lisätietoa pinta-alasta</span><span class="sc-nrwXf cJAasx">Sisäänvedetty kulmaparveke, kellarikomero</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kokonaispinta-ala</span><span class="sc-nrwXf cJAasx">66.5 m&sup2;</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kerros</span><span class="sc-nrwXf cJAasx">2/4</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Hissi</span><span class="sc-nrwXf cJAasx">Kyllä</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Näkymät asunnosta</span><span class="sc-nrwXf cJAasx">Puistomaiset, pihalle. Ikkunasuunnat: pohjoinen, itä</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Parveke</span><span class="sc-nrwXf cJAasx">Kyllä, sisäänvedetty, lasitettu. kulmaparveke lasikaiteella</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Parvekkeen suunta</span><span class="sc-nrwXf cJAasx">Pohjoinen, itä</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Säilytystilat</span><span class="sc-nrwXf cJAasx">Kellari, muu erillinen varasto</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Autopaikka</span><span class="sc-nrwXf cJAasx">Autopaikka ostettavissa tai vuokrattavissa erillisestä pysäköintitalosta, Myynnissä erikseen autotalleja a 32teur ja autopaikkoja (sähköauton latausvalmius)</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Energiatehokkuusluokka</span><span class="sc-nrwXf cJAasx">A<sub>2018</sub></span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Huoneiston kunto</span><span class="sc-nrwXf cJAasx">Uusi</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Vapautuminen</span><span class="sc-nrwXf cJAasx">Kohteen valmistuttua 2026/2027 vuodenvaihteessa, arvioitu 31.12.2026. </span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Lisätietoja huoneistosta</span><span class="sc-nrwXf cJAasx">Pintamateriaalit oman sisustusesitteen valintojen mukaisesti (4-5/2026 saakka). </span></div></div></div><div class="sc-gGCbJM jkhudZ"><div class="sc-lcpuFF gBszgu"><h3>Varustus</h3><span class="sc-bqjOQT bzuiHt"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl brwBVU"><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Keittiö</span><span class="sc-nrwXf cJAasx">Puustelli-keittiö, jääkaappi/pakastin, astianpesukone, kaapistot, induktioliesi, liesikupu/-tuuletin, mikrosyvennys, välitila alumiinipintaista levyä, allas tasoon upotettava RST- tai kivikomposiittiallas, kalusteet hidastimin. Sisustusesitteen valintojen mukaisesti.</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Saniteettitilat</span><span class="sc-nrwXf cJAasx">Kylpyhuone, suihku, peilit, pesukoneliitäntä, lattialämmitys, kylpyhuonekaapisto, kiinteät valaisimet, sauna (lasiseinällä), kh-tila, 2wc. Laatat Pukkila Stone-age sarjasta, Oras-vesikalusteet. Kts sisustusesite/omat valinnat.</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Makuuhuone</span><span class="sc-nrwXf cJAasx">Kaapistot suunnitelman mukaisesti.</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Muuta kauppaan kuuluvaa</span><span class="sc-nrwXf cJAasx">Sälekaihtimet, vaatekaapistot, lasitettu parveke, valokuitu. . TV-antennit: Liitetty yhtiön kaapeli-tv liittymään. Tietoliikenneyhteydet: Valokuitu</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Laajakaistayhteys</span><span class="sc-nrwXf cJAasx">Valokuitu</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Säilytystilat asunnossa</span><span class="sc-nrwXf cJAasx">Kaapistot, kellarikomero</span></div></div></div><div class="sc-gGCbJM jkhudZ"><div class="sc-lcpuFF gBszgu"><h3>Tilat, materiaalit ja varustus</h3><span class="sc-bqjOQT bzuiHt"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl brwBVU"><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Keittiö</span><span class="sc-nrwXf cJAasx">Puustelli-keittiö, jääkaappi/pakastin, astianpesukone, kaapistot, induktioliesi, liesikupu/-tuuletin, integroitu mikro, välitila alumiinipintaista levyä, allas tasoon upotettava RST- tai kivikomposiittiallas, kalusteet hidastimin. Sisustusesitteen valintojen mukaisesti. Lattia: Vinyylilankku. Seinät: Maalattu, alumiinipintainen levy välitilassa. </span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kylpyhuone</span><span class="sc-nrwXf cJAasx">Kylpyhuone, suihku, peilit, pesukoneliitäntä, lattialämmitys, kylpyhuonekaapisto, kiinteät valaisimet, sauna (lasiseinällä), kh-tila, 2wc. Laatat Pukkila Stone-age sarjasta, Oras-vesikalusteet. Kts sisustusesite/omat valinnat. Lattia: Laatta. Seinät: Laatta (Pukkila Stone-Age)</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Olohuone</span><span class="sc-nrwXf cJAasx">Lattia: Vinyylilankku. Seinät: Maalattu</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Makuuhuone</span><span class="sc-nrwXf cJAasx">Kaapistot suunnitelman mukaisesti. Lattia: Vinyylilankku. Seinät: Maalattu</span></div></div></div><div class="sc-gGCbJM jkhudZ"><div class="sc-lcpuFF gBszgu"><h3>Sijainti kartalla</h3><span class="sc-bqjOQT bzuiHt"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl brwBVU"><div class="sc-cCVOAp itmLcg"></div></div></div><div class="sc-gGCbJM jkhudZ"><div class="sc-lcpuFF gBszgu"><h3>Hinta- ja asumiskustannukset</h3><span class="sc-bqjOQT bzuiHt"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl brwBVU"><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Myyntihinta</span><span class="sc-nrwXf cJAasx">154 800,00 &euro;</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Velkaosuus</span><span class="sc-nrwXf cJAasx">232 200,00 &euro;</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Velaton hinta</span><span class="sc-nrwXf cJAasx">387 000,00 &euro;</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Hoitovastike</span><span class="sc-nrwXf cJAasx">266,00 &euro;/kk</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Rahoitusvastike</span><span class="sc-nrwXf cJAasx">561,15 &euro;/kk</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Tontinvuokravastike</span><span class="sc-nrwXf cJAasx">411,14 &euro;/kk</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Yhtiövastike yhteensä</span><span class="sc-nrwXf cJAasx">1 238,29 &euro;/kk</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Vesimaksu</span><span class="sc-nrwXf cJAasx">Käytön mukaan</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Lisätietoja kustannuksista</span><span class="sc-nrwXf cJAasx">Sauna, pesula yms maksut päätetään myöhemmin. Rahoitusvastike ilmoitettu lyhennysvapaan aikana (lyhennysten alkaessa arvio 1402,45eur/kk). Tonttiosuuden voi lunastaa (vs-vero 3% tontin osalta). Vuokratontin lunastushinta arvioitu  82 227,36 euroa  (kts lisätiedot). </span></div><p>Kohde on yhtiölainoitettu. Taloyhtiölainasta on vastuussa jokainen osakas. Jos lainaa koskevia pääomavastikkeita ei saada joidenkin asuntojen osalta muutoin perittyä, maksuvelvollisuus voi langeta viime kädessä muille osakkaille.</p><p>Kohde sijaitsee valinnaisella vuokratontilla. Osakkaalla on oikeus lunastaa asunto-osakkeisiin kohdistuva tontin osuus taloyhtiölle.</p></div></div><div class="sc-gGCbJM jkhudZ"><div class="sc-lcpuFF gBszgu"><h3>Taloyhtiö</h3><span class="sc-bqjOQT fcGJtF"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl hUMygZ"><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Taloyhtiön nimi</span><span class="sc-nrwXf cJAasx">Asunto Oy Helsingin Pakilan Promenadi</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Talotyyppi</span><span class="sc-nrwXf cJAasx">Kerrostalo</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Tontin pinta-ala</span><span class="sc-nrwXf cJAasx">1481 m&sup2;</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Tontin omistus</span><span class="sc-nrwXf cJAasx">Valinnainen vuokratontti</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Lisätietoja valinnaisesta vuokratontista</span><span class="sc-nrwXf cJAasx">DEAS-tonttirahasto ky. Kts liitteenä maanvuokrasopimus. Lunastus kaupanteon jälkeen tai vuosittain (kts ehdot tarkemmin määräosien lunastussopimuksesta ja maanvuokrasopimuksesta, tontin lunastus 3% vs-vero). </span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Rakennusvuosi</span><span class="sc-nrwXf cJAasx">2026</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Rakennusmateriaali</span><span class="sc-nrwXf cJAasx">Tiili.<br /><br />Tiili, betoni, julkisivu pääosin tiiltä.</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Lämmitysjärjestelmä</span><span class="sc-nrwXf cJAasx">Maalämpö<br /><br />Lämmönjakotapa: Vesikiertoinen lattialämmitys<br /><br />Maalämpö, asunnoissa vesikiertoinen lattialämmitys, LTO, A-energialuokka. </span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kattotyyppi</span><span class="sc-nrwXf cJAasx">Harjakatto</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kate</span><span class="sc-nrwXf cJAasx">Peltikate (sileä)</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Kiinteistön hoidosta vastaa</span><span class="sc-nrwXf cJAasx">Huoltoyhtiö</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Taloyhtiössä on</span><span class="sc-nrwXf cJAasx">Ulkoiluvälinevarasto (kylmä ja lämmin), talovarasto, irtaimistovarastot, jätehuone, talopesula, ulkokuntoilupaikka pihalla, lasten leikkipaikka (kts asemapiirustus), hissi. Pihapaikkojen hv 32€/kk. Kylmä at 2 €/m2, puolilämmin at 50,4-56 €/kk, kts yhtiöjärjestyskestä maksuperusteet. Irtaimistovarastojen numerointi päivitetty 3/2026 (kts piirustus)</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Rakennukseen tehdyt korjaukset</span><span class="sc-nrwXf cJAasx">Uudiskohde, arvioitu valmistuminen 3012/2026</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Tiedossa olevat korjaukset</span><span class="sc-nrwXf cJAasx">Sisäänmuuttotarkastus ja 1-vuotistarkastus asuntokauppalain mukaan. </span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Muuta</span><span class="sc-nrwXf cJAasx">Taloyhtiön väylät/parkki-alue pääosin asfaltoitu, osin nurmikivetty. Autotalleissa nro 2-5 patterilämmitys (vesikiertoiset patterit), 
At1 kylmä talli. Yleinen piha-alue asemapiirroksen yms suunnitelmien mukaisesti (ulkokuntoilupaikka, lasten leikkipaikka yms). www.pakilanpromenadi.fi </span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Huoneistot yhteensä</span><span class="sc-nrwXf cJAasx">18 kpl</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Asuinhuoneistojen kokonaispinta-ala</span><span class="sc-nrwXf cJAasx">1232 m&sup2;</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Liikehuoneistot</span><span class="sc-nrwXf cJAasx">2 kpl</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Liikehuoneistojen kokonaispinta-ala</span><span class="sc-nrwXf cJAasx">125 m&sup2;</span></div></div></div><div class="sc-gGCbJM jkhudZ"><div class="sc-lcpuFF gBszgu"><h3>Liikenneyhteydet ja palvelut</h3><span class="sc-bqjOQT fcGJtF"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl hUMygZ"><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Lähipalvelut</span><span class="sc-nrwXf cJAasx">Koulut: Pakilan ylä- ja ala-aste, Paloheinän ala-aste, Torpparinmäen peruskoulu (1-9lk), Maunulan koulut, Metsolan koulu (Itä-Pakila), suomalais-venäläinen koulu, Oulunkylän ja Käpylän lukio alk.  n. 0,5 km; Päiväkodit: Pk Eloisa (Havukka), Montessori, Pikku Marjatta ja Pakila (Länsi-Pakila), Pk Miilu, Kytöniitty, Valkea, Pikkusuo (Paloheinä), Pk Vallesmanni, Kotitorppa, Torpparintupa, Norlandia (Torpparinmäki), Pk Haltia, Tammi, Ankkalampi, Perhonen, Pakilan lastenpaikka (Itä-Pakila), Pk Korento, Maunula yms (Maunula) alk. n. 0,5 km; Ruokakaupat: S-market (Pakila, Maunula ja Torpparinmäki), K-supermarket (Torpparinmäki), Alepa (Paloheinä, Maunula ja Itä-Pakila), LIDL (Pakila), K-market Pikkusisko (Itä-Pakila), Teboil (Pakila), Kaari kauppakeskus ja Prisma, ABC-Tuomarinkylä, City-Market Tammisto alk. n. 0,6 km; Muut lähipalvelut: Paloheinän golf, jäähalli, pulkkamäki, kiipeilypuisto, frisbee-golf-rata, hiihtoladut, Haltialan ulkoilualueet, Keskuspuisto, Tuomarinkylän miljöö, Pakilan musiikkiopisto, Paloheinän musiikkikoulu ja kuvataidekoulu, HPS-arena, Namika-arena, Paloheinän ja Maunulan kirjasto ja terveyskeskus, apteekki, R-kioski, lähikahvilat ja Palomaja, Alko, Teboil-Pakila, Kukkatalo, Kauppakeskus Kaari, Oulunkylän ja Pirkkolan liikuntapuisto (mm. luistinrata, tenniskenttä, padel, uimahalli) alk. n. 0,6 km</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Koulut</span><span class="sc-nrwXf cJAasx">Pakilan ylä- ja ala-aste, Paloheinän ala-aste, Torpparinmäen peruskoulu (1-9lk), Maunulan koulut, Metsolan koulu (Itä-Pakila), suomalais-venäläinen koulu, Oulunkylän ja Käpylän lukio alk.  (n. 0.5 km)</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Päiväkoti</span><span class="sc-nrwXf cJAasx">Pk Eloisa (Havukka), Montessori, Pikku Marjatta ja Pakila (Länsi-Pakila), Pk Miilu, Kytöniitty, Valkea, Pikkusuo (Paloheinä), Pk Vallesmanni, Kotitorppa, Torpparintupa, Norlandia (Torpparinmäki), Pk Haltia, Tammi, Ankkalampi, Perhonen, Pakilan lastenpaikka (Itä-Pakila), Pk Korento, Maunula yms (Maunula) alk. (n. 0.5 km)</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Liikenneyhteydet</span><span class="sc-nrwXf cJAasx">Bussit esim. 66, 63, 67, 64, 23, 553, 560, Pikaratikka 15 (Oulunkylä-Maunula-Pirkkola), Tuusulanväylä ja Kehä I linjat ja vaihtopysäkit alk n. 0,1 km</span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Ruokakaupat</span><span class="sc-nrwXf cJAasx">S-market (Pakila, Maunula ja Torpparinmäki), K-supermarket (Torpparinmäki), Alepa (Paloheinä, Maunula ja Itä-Pakila), LIDL (Pakila), K-market Pikkusisko (Itä-Pakila), Teboil (Pakila), Kaari kauppakeskus ja Prisma, ABC-Tuomarinkylä, City-Market Tammisto alk. (n. 0.6 km)</span></div></div></div><div class="sc-gGCbJM eGNEOR"><div class="sc-lcpuFF gBszgu"><h3>Lisätiedot</h3><span class="sc-bqjOQT fcGJtF"><svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="angle-down" class="svg-inline--fa fa-angle-down fa-w-10 " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M151.5 347.8L3.5 201c-4.7-4.7-4.7-12.3 0-17l19.8-19.8c4.7-4.7 12.3-4.7 17 0L160 282.7l119.7-118.5c4.7-4.7 12.3-4.7 17 0l19.8 19.8c4.7 4.7 4.7 12.3 0 17l-148 146.8c-4.7 4.7-12.3 4.7-17 0z"></path></svg></span></div><div class="sc-jkCMRl hUMygZ"><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Asuntomyymälä</span><span class="sc-nrwXf cJAasx"><a href="/helsinki-pakila-paloheina">Kiinteistömaailma Helsinki Pakila-Paloheinä</a><br />LKV Autero Oy , Pakilantie 85 (Lh 13), 00660, Helsinki<br />Puh. <a href="tel:0503386438">+358503386438</a><br /><a href="mailto:pakila@kiinteistomaailma.fi">Lähetä sähköpostia</a></span></div><div class="sc-crNyjn jRzrPl"><span class="sc-cpHetk jjFbvt">Välittäjä</span><span class="sc-nrwXf cJAasx">Oma välittäjäsi tai NICO AUTERO gsm. 050 521 4810 nico.autero(at)km.fi
