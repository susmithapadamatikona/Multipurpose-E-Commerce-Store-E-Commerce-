<script>
(function(){
if (typeof window !== 'undefined') {
function detectIE() {
try {
var ua = window.navigator.userAgent;
var msie = ua.indexOf('MSIE ');
if (msie > 0) {
return parseInt(ua.substring(msie + 5, ua.indexOf('.', msie)), 10);
}

var trident = ua.indexOf('Trident/');
if (trident > 0) {
var rv = ua.indexOf('rv:');
return parseInt(ua.substring(rv + 3, ua.indexOf('.', rv)), 10);
}
return false;
} catch (e) {
return false;
}
}

var ie = detectIE();

if (ie) {
var container = document.createElement('div');
container.id = 'ie-warning';
var content = document.createElement('div');
content.id = 'ie-warning-content';
var title = document.createElement('h2');
var text = document.createElement('p');
title.innerText = 'Käytät vanhentunutta selainta';
text.innerHTML = 'Kiinteistomaailma.fi sivusto ei toimi Internet Explorer -selaimella.<br />Käytä sen sijaan esim. Chrome, Edge, Firefox tai Safari -selaimia.';
var logo = document.createElement('img');
logo.src = '/assets/images/brand-identity/logos/km-logo-horizontal.png';
logo.className = 'logo';
content.appendChild(title);
content.appendChild(text);
container.appendChild(content);
container.appendChild(logo);
document.body.insertAdjacentElement('afterbegin', container);
document.body.style.overflow = 'hidden';
document.body.style.position = 'fixed';
}
}
})();
